   <text>
      <body>
         <!-- 
            ** Instructions **
            
            Toutes les mentions lieux doivent être indexés
            Rmq : il n’est pas nécessaire d’indexer les lieux dans les citations bibliographiques, lieux de conservation et d’exposition renseignés avec les œuvres ou les expositions.
            Rmq : afin d’alléger le balisage, on marque seulement la première occurence d’un nom au sein d’un paragraphe
            
            Les noms de lieux sont balisés dans le texte avec <placeName>
            
            Pour les noms de lieux, utiliser la forme internationale du nom en recherchant l’entité dans un catalogue d’autorité :
            - https://catalogue.bnf.fr/recherche-autorite.do/
            - https://www.wikidata.org
            - https://www.loc.gov/aba/cataloging/authority/
            
            Créer une notice avec un identifiant xml:id en suivant le modèle ci-dessous
            Pour faciliter le référencement dans les textes, on suggère d’utiliser le nom, prénom avec la notation lowerCamelCase pour les identifiants. 
            Insérer dans le texte une balise <placeName> avec l’atribut @ref et la cible (utiliser un dièse).
            
            Exemple : Avec l’xml:id xml:id="paris"
            La ville de <placeName ref="#paris">Paris</placeName> constitue une capitale artistique de...
         -->
         <listPlace><!-- Rosalie -->
            <place xml:id="paris-France"><!-- exemple d'Emmanuel-->
               <placeName>Paris (France)</placeName>
               <region>[si province ou état : ex: québec, état américain</region>
               <country>France</country>
               <idno type="wikidata">https://www.wikidata.org/wiki/Q90</idno>
               <idno type="bnf">https://catalogue.bnf.fr/ark:/12148/cb152821567</idno>
            </place>
            <place xml:id="etats-Unis">
               <placeName xml:lang="en">United States</placeName>
               <placeName xml:lang="fr">États-Unis</placeName>
               <!-- USA, US -->
               <idno type="wikidata">https://www.wikidata.org/wiki/Q30</idno>
               <idno type="bnf">https://catalogue.bnf.fr/ark:/12148/cb12182520r</idno>
            </place>
            <place xml:id="royaume-Uni">
               <placeName xml:lang="en">United Kingdom</placeName>
               <placeName xml:lang="fr">Royaume-Uni</placeName>
               <!-- UK -->
               <idno type="wikidata">https://www.wikidata.org/wiki/Q145</idno>
               <idno type="bnf">https://catalogue.bnf.fr/ark:/12148/cb15238574p</idno>
            </place>
            <place xml:id="canada">
               <placeName>Canada</placeName>
               <idno type="wikidata">https://www.wikidata.org/wiki/Q16</idno>
               <idno type="loc">http://id.loc.gov/vocabulary/geographicAreas/n-cn</idno>
               <idno type="isni">https://isni.org/isni/0000000122385050</idno>
            </place>
            <place xml:id="grenoble-France">
               <placeName>Grenoble (France)</placeName>
               <!-- notice bnf "Grenoble (Isère, France)" / notice Loc "Grenoble (France)"-->
               <region>Isère, département français</region>
               <country>France</country>
               <idno type="wikidata">https://www.wikidata.org/wiki/Q1289</idno>
               <idno type="bnf">https://catalogue.bnf.fr/ark:/12148/cb119342062</idno>
               <idno type="loc">http://id.loc.gov/authorities/names/n79091186</idno>
            </place>
            <place xml:id="kyoto-Japon">
               <placeName>Kyoto (Japon)</placeName>
               <country>Japon</country>
               <idno type="wikidata">https://www.wikidata.org/wiki/Q34600</idno>
               <idno type="loc">https://id.loc.gov/authorities/names/n80024170.html</idno>
               <idno type="isni">https://isni.org/isni/0000000403889925</idno>
            </place>
            <place xml:id="santiago-Chili">
               <placeName>Santiago de Chile</placeName>
               <country>Chili</country>
               <idno type="wikidata">https://www.wikidata.org/wiki/Q2887</idno>
               <idno type="loc">https://id.loc.gov/authorities/names/n79077402</idno>
               <idno type="isni">https://isni.org/isni/0000000121627820</idno>
               <idno type="bnf">https://catalogue.bnf.fr/ark:/12148/cb120000849</idno>
            </place>
            <place xml:id="chili">
               <placeName xml:lang="fr">Chili</placeName>
               <placeName xml:lang="en">Chile</placeName>
               <idno type="wikidata">https://www.wikidata.org/wiki/Q298</idno>
               <idno type="loc">https://id.loc.gov/authorities/names/n79061242</idno>
               <idno type="bnf">https://catalogue.bnf.fr/ark:/12148/cb15238523s</idno>
               <idno type="isni">https://isni.org/isni/0000000121695380</idno>
            </place>
            <place xml:id="washington-DC"><!-- la capitale - ne pas confondre avec l'état de Washington-->
               <placeName>Washington D.C.</placeName>
               <country>États-Unis</country>
               <!-- pas de balise region parce que ne fait officiellement partie d'aucun état--> 
               <idno type="wikidata">https://www.wikidata.org/wiki/Q61</idno>
               <idno type="bnf">https://catalogue.bnf.fr/ark:/12148/cb11881081d</idno>
               <idno type="loc">https://id.loc.gov/authorities/names/n79018774</idno>
               <idno type="isni">https://isni.org/isni/0000000122968205</idno>
            </place>
            <place xml:id="prague-RépubliqueTchèque">
               <placeName>Prague (République tchèque)</placeName>
               <country>République tchèque</country>
               <idno type="wikidata">https://www.wikidata.org/wiki/Q1085</idno>
               <idno type="bnf">https://catalogue.bnf.fr/ark:/12148/cb15239961p</idno>
               <idno type="loc">https://id.loc.gov/authorities/names/n79055764</idno>
               <idno type="isni">https://isni.org/isni/0000000406102462</idno>
            </place>
            <place xml:id="australie">
               <placeName xml:lang="fr">Australie</placeName>
               <placeName xml:lang="en">Australia</placeName>
               <idno type="wikidata">https://www.wikidata.org/wiki/Q408</idno>
               <idno type="bnf">https://catalogue.bnf.fr/ark:/12148/cb15238526t</idno>
               <idno type="loc">https://id.loc.gov/authorities/names/n79021326</idno>
               <idno type="isni">https://isni.org/isni/0000000120969976</idno>
            </place>
            <place xml:id="québec-Province">
               <!-- j'ai mis province et non canada dans le id pour éviter la confusion avec la ville #RC-->
               <placeName xml:lang="fr">Québec (Province)</placeName>
               <placeName xml:lang="en">Quebec (Province)</placeName>
               <country>Canada</country>
               <idno type="wikidata">https://www.wikidata.org/wiki/Q176</idno>
               <idno type="bnf">https://catalogue.bnf.fr/ark:/12148/cb119396489</idno>
               <idno type="loc">https://id.loc.gov/authorities/names/n80001244</idno>
               <idno type="isni">https://isni.org/isni/0000000121928834</idno>
            </place>
            <place xml:id="montréal-Canada">
               <placeName xml:lang="fr">Montréal (Canada)</placeName>
               <placeName xml:lang="en">Montreal (Canada)</placeName>
               <!-- identifiant Library of Congress = Montréal (Québec) / identifiant bnf = Montréal (Canada)--> 
               <country>Canada</country>
               <region>Québec (Province)</region>
               <idno type="wikidata">https://www.wikidata.org/wiki/Q340</idno>
               <idno type="bnf">https://catalogue.bnf.fr/ark:/12148/cb118804980</idno>
               <idno type="loc">https://id.loc.gov/authorities/names/n80132975</idno>
               <idno type="isni">https://isni.org/isni/0000000121501478</idno>
            </place>
            <place xml:id="europe">
               <placeName>Europe</placeName>
               <idno type="wikidata">https://www.wikidata.org/wiki/Q46</idno>
               <idno type="bnf">https://catalogue.bnf.fr/ark:/12148/cb11931301w</idno>
               <idno type="loc">https://id.loc.gov/authorities/subjects/sh85045631</idno>
            </place>
         </listPlace>
         <listPlace><!-- Julie -->
            <place></place>
         </listPlace>
      </body>
